@model FixItNepal.Models.Booking
@{
    ViewData["Title"] = "Booking Details";
    var isProvider = (bool)ViewBag.IsProvider;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-info-circle me-2 text-primary"></i>Booking Details</h2>
        <a asp-action="MyBookings" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back to List</a>
    </div>

    <div class="row g-4">
        <div class="col-md-8">
            <!-- Booking Info -->
             <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">Service Information</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4 text-muted">Service Name</div>
                        <div class="col-md-8 fw-bold">@Model.ServiceItem?.Name</div>
                    </div>
                     <div class="row mb-3">
                        <div class="col-md-4 text-muted">Date</div>
                        <div class="col-md-8">@Model.BookingDate.ToLongDateString()</div>
                    </div>
                     <div class="row mb-3">
                        <div class="col-md-4 text-muted">Time Slot</div>
                        <div class="col-md-8">@Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</div>
                    </div>
                     <div class="row mb-3">
                        <div class="col-md-4 text-muted">Total Price</div>
                        <div class="col-md-8 text-primary fw-bold">Rs. @Model.TotalPrice</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4 text-muted">Status</div>
                        <div class="col-md-8">
                             @switch (Model.Status)
                            {
                                case FixItNepal.Models.BookingStatus.Pending:
                                    <span class="badge bg-warning text-dark">Pending</span>
                                    break;
                                case FixItNepal.Models.BookingStatus.Confirmed:
                                    <span class="badge bg-success">Confirmed</span>
                                    break;
                                case FixItNepal.Models.BookingStatus.Rejected:
                                    <span class="badge bg-danger">Rejected</span>
                                    break;
                                case FixItNepal.Models.BookingStatus.Cancelled:
                                    <span class="badge bg-secondary">Cancelled</span>
                                    break;
                                 case FixItNepal.Models.BookingStatus.Completed:
                                    <span class="badge bg-primary">Completed</span>
                                    break;
                                case FixItNepal.Models.BookingStatus.AwaitingConfirmation:
                                    <span class="badge bg-info text-dark">Awaiting Completion Confirmation</span>
                                    break;
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                         <div class="row mb-3">
                            <div class="col-md-4 text-muted">Notes</div>
                            <div class="col-md-8">@Model.Notes</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Feedback & Disputes -->
            @if (Model.Status == FixItNepal.Models.BookingStatus.Completed)
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-0">Feedback & Review</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.Review != null)
                        {
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <div class="mb-2">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="bi bi-star-fill @(i <= Model.Review.Rating ? "text-warning" : "text-muted")"></i>
                                        }
                                    </div>
                                    <p class="mb-1">@Model.Review.Comment</p>
                                    <small class="text-muted">Reviewed on @Model.Review.CreatedAt.ToShortDateString()</small>
                                </div>
                                <form asp-controller="ReviewApi" asp-action="FlagReview" asp-route-id="@Model.Review.Id" method="post" class="d-inline">
                                    <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none" onclick="flagReview(@Model.Review.Id)">
                                        <i class="bi bi-flag me-1"></i>Report
                                    </button>
                                </form>
                            </div>
                        }
                        else if (!isProvider)
                        {
                            <div class="text-center py-3">
                                <p class="mb-3">How was your service? Share your feedback to help others.</p>
                                <a asp-controller="Review" asp-action="Create" asp-route-bookingId="@Model.Id" class="btn btn-primary">
                                    <i class="bi bi-star me-2"></i>Leave a Review
                                </a>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center py-2">No review received yet.</p>
                        }
                    </div>
                </div>
            }

            @if (Model.Status != FixItNepal.Models.BookingStatus.Cancelled && Model.Status != FixItNepal.Models.BookingStatus.Rejected)
            {
                <div class="card shadow-sm border-0 mb-4 border-start border-4 border-danger">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-1">Having an issue?</h6>
                            <p class="small text-muted mb-0">Raise a dispute if something went wrong with this booking.</p>
                        </div>
                        <a asp-controller="Dispute" asp-action="Create" asp-route-bookingId="@Model.Id" class="btn btn-outline-danger btn-sm">
                            Raise Dispute
                        </a>
                    </div>
                </div>
            }

            <!-- Customer Actions -->
            @if (!isProvider)
            {
                <div class="d-flex gap-2">
                    @if (Model.Status == FixItNepal.Models.BookingStatus.Pending)
                    {
                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="status" value="Cancelled" />
                            <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to cancel this booking?')"><i class="bi bi-x-circle me-2"></i>Cancel Booking</button>
                        </form>
                    }
                    
                    @if (Model.Status == FixItNepal.Models.BookingStatus.AwaitingConfirmation)
                    {
                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="status" value="Completed" />
                            <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-2"></i>Confirm Completion</button>
                        </form>
                    }
                </div>
            }
            
            <!-- Provider Actions -->
            @if (isProvider)
            {
                var existingBookings = ViewBag.ExistingBookings as List<FixItNepal.Models.Booking>;
                if (existingBookings != null && existingBookings.Any() && Model.Status == FixItNepal.Models.BookingStatus.Pending)
                {
                    <div class="alert alert-warning mb-4">
                        <h6 class="fw-bold"><i class="bi bi-calendar-event me-2"></i>Schedule Warning</h6>
                        <p class="mb-2 small">You already have the following confirmed bookings on this date (@Model.BookingDate.ToShortDateString()):</p>
                        <ul class="mb-0 small">
                            @foreach (var exBooking in existingBookings)
                            {
                                <li><strong>@exBooking.StartTime.ToString(@"hh\:mm")</strong> - @exBooking.ServiceItem?.Name</li>
                            }
                        </ul>
                    </div>
                }

                <div class="d-flex gap-2">
                    @if (Model.Status == FixItNepal.Models.BookingStatus.Pending)
                    {
                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="status" value="Confirmed" />
                            <button type="submit" class="btn btn-success"><i class="bi bi-check-lg me-2"></i>Accept Booking</button>
                        </form>
                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="status" value="Rejected" />
                            <button type="submit" class="btn btn-danger"><i class="bi bi-x-lg me-2"></i>Reject Booking</button>
                        </form>
                    }
                    
                    @if (Model.Status == FixItNepal.Models.BookingStatus.Confirmed)
                    {
                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="status" value="AwaitingConfirmation" />
                            <button type="submit" class="btn btn-primary"><i class="bi bi-hammer me-2"></i>Mark as Finished</button>
                        </form>
                    }
                </div>
            }
        </div>

        <div class="col-md-4">
            <!-- Other Party Profile -->
             <div class="card shadow-sm border-0">
                <div class="card-body text-center p-4">
                    @if (isProvider)
                    {
                         <h5 class="fw-bold mb-4">Customer Details</h5>
                         @if (!string.IsNullOrEmpty(Model.Customer?.User?.ProfilePicture))
                        {
                            <img src="~/uploads/profiles/@Model.Customer.User.ProfilePicture" class="rounded-circle mb-3 shadow-sm" style="width: 100px; height: 100px; object-fit: cover;">
                        }
                        else
                        {
                             <div class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center mx-auto mb-3 shadow-sm" style="width: 100px; height: 100px; font-size: 2rem;">
                                @Model.Customer?.User?.FullName?.Substring(0, 1).ToUpper()
                            </div>
                        }
                        
                         <h5 class="fw-bold">@Model.Customer?.User?.FullName</h5>
                         <p class="text-muted"><i class="bi bi-envelope me-2"></i>@Model.Customer?.User?.Email</p>
                         
                         <hr />
                         <div class="text-start">
                             <p class="mb-2"><i class="bi bi-telephone me-2 text-primary"></i><strong>Phone:</strong> @(Model.CustomerPhone ?? Model.Customer?.User?.PhoneNumber ?? "N/A")</p>
                             <p class="mb-2"><i class="bi bi-geo-alt me-2 text-primary"></i><strong>Address:</strong> @(Model.CustomerAddress ?? Model.Customer?.PreferredLocation ?? "N/A")</p>
                         </div>
                         <a asp-controller="Chat" asp-action="Index" asp-route-userId="@Model.Customer?.UserId" asp-route-bookingId="@Model.Id" class="btn btn-primary w-100 mt-3 rounded-pill shadow-sm">
                             <i class="bi bi-chat-dots me-2"></i>Chat with Customer
                         </a>
                    }
                    else
                    {
                         <h5 class="fw-bold mb-4">Provider Details</h5>
                         @if (!string.IsNullOrEmpty(Model.ServiceProvider?.User?.ProfilePicture))
                        {
                             <a asp-controller="Home" asp-action="ProviderDetails" asp-route-id="@Model.ServiceProviderId">
                                <img src="~/uploads/profiles/@Model.ServiceProvider.User.ProfilePicture" class="rounded-circle mb-3 shadow-sm hover-shadow" style="width: 100px; height: 100px; object-fit: cover;">
                             </a>
                        }
                        else
                        {
                             <a asp-controller="Home" asp-action="ProviderDetails" asp-route-id="@Model.ServiceProviderId" class="text-decoration-none">
                                <div class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center mx-auto mb-3 shadow-sm hover-shadow" style="width: 100px; height: 100px; font-size: 2rem;">
                                    @Model.ServiceProvider?.User?.FullName?.Substring(0, 1).ToUpper()
                                </div>
                             </a>
                        }
                        
                         <a asp-controller="Home" asp-action="ProviderDetails" asp-route-id="@Model.ServiceProviderId" class="text-decoration-none text-dark">
                             <h5 class="fw-bold hover-primary">@Model.ServiceProvider?.User?.FullName</h5>
                         </a>
                          <p class="text-muted mb-2">@Model.ServiceProvider?.ServiceCategory?.Name Specialst</p>
                          
                          <div class="d-grid gap-2 mt-3">
                              <a asp-controller="Home" asp-action="ProviderDetails" asp-route-id="@Model.ServiceProviderId" class="btn btn-outline-primary btn-sm rounded-pill">View Profile</a>
                              <a asp-controller="Chat" asp-action="Index" asp-route-userId="@Model.ServiceProvider?.UserId" asp-route-bookingId="@Model.Id" class="btn btn-primary rounded-pill shadow-sm">
                                  <i class="bi bi-chat-dots me-2"></i>Chat with Provider
                              </a>
                          </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        function flagReview(reviewId) {
            const reason = prompt("Please provide a reason for flagging this review:");
            if (reason === null) return; // User cancelled
            if (reason.trim() === "") {
                alert("Please provide a reason.");
                return;
            }

            fetch(`/api/ReviewApi/flag/${reviewId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(reason)
            })
            .then(response => {
                if (response.ok) {
                    alert("Thank you. The review has been flagged for moderation.");
                    location.reload();
                } else {
                    alert("Failed to flag review. Please try again.");
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert("An error occurred. Please try again.");
            });
        }
    </script>
}
