@model FixItNepal.ViewModels.ReviewViewModel
@{
    ViewData["Title"] = "Leave Review";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="h4 mb-4 text-primary">Leave a Review</h2>
                    <p class="text-muted">How was your experience with <strong>@Model.ServiceProviderName</strong> for <strong>@Model.ServiceName</strong>?</p>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="BookingId" />
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold">Rating</label>
                            <div class="rating-input d-flex gap-3">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="Rating" value="@i" id="rating@i" required>
                                        <label class="form-check-label" for="rating@i">
                                            @i <i class="bi bi-star-fill text-warning"></i>
                                        </label>
                                    </div>
                                }
                            </div>
                            <span asp-validation-for="Rating" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Comment" class="form-label fw-bold">Your Feedback</label>
                            <textarea asp-for="Comment" class="form-control" rows="4" placeholder="Share your experience..."></textarea>
                            <span asp-validation-for="Comment" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">Submit Review</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
