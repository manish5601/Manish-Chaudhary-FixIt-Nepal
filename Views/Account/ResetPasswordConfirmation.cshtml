@{
    ViewData["Title"] = "Password Reset Complete";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 text-center">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-5">
                    <div class="bg-success-subtle rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-shield-check text-success fs-1"></i>
                    </div>
                    <h2 class="fw-bold">Password Reset!</h2>
                    <p class="text-muted small">Your password has been successfully reset. You can now log in with your new credentials.</p>
                    
                    <div class="mt-4">
                        <a asp-action="Login" class="btn btn-orange btn-lg rounded-pill shadow-sm px-5">
                            Log In Now
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-orange { background-color: #fd7e14; color: white; border: none; }
    .btn-orange:hover { background-color: #e8590c; color: white; }
</style>
