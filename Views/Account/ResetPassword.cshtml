@model FixItNepal.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="bg-orange-subtle rounded-circle d-inline-flex p-3 mb-3">
                            <i class="bi bi-key text-orange fs-1"></i>
                        </div>
                        <h2 class="fw-bold">Security First</h2>
                        <p class="text-muted">Set a strong new password for your account.</p>
                    </div>

                    <form asp-action="ResetPassword" method="post">
                        <input type="hidden" asp-for="Token" />
                        <input type="hidden" asp-for="UserId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold">New Password</label>
                            <input asp-for="Password" class="form-control form-control-lg rounded-3 border-light bg-light" placeholder="Min 6 characters" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm New Password</label>
                            <input asp-for="ConfirmPassword" class="form-control form-control-lg rounded-3 border-light bg-light" placeholder="Repeat password" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-orange btn-lg w-100 rounded-pill shadow-sm mb-3">
                            Update Password
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-orange { color: #fd7e14; }
    .bg-orange-subtle { background-color: rgba(253, 126, 20, 0.1); }
    .btn-orange { background-color: #fd7e14; color: white; border: none; }
    .btn-orange:hover { background-color: #e8590c; color: white; }
    .form-control:focus { border-color: #fd7e14; box-shadow: 0 0 0 0.25rem rgba(253, 126, 20, 0.25); }
</style>
