@{
    ViewData["Title"] = "Email Sent";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-5 text-center">
                    <div class="bg-success-subtle rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-envelope-check text-success fs-1"></i>
                    </div>
                    <h2 class="fw-bold">Check Your Email</h2>
                    <p class="text-muted">If an account matches that email, we've sent a link to reset your password. Please check your inbox (and spam folder).</p>
                    
                    <div class="mt-4">
                        <a asp-action="Login" class="btn btn-outline-primary rounded-pill px-4">
                            Proceed to Login
                        </a>
                    </div>
                    
                    <p class="mt-4 text-muted small">
                        Didn't receive the email? <a asp-action="ForgotPassword" class="text-primary text-decoration-none fw-bold">Try again</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
