@model FixItNepal.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="bg-orange-subtle rounded-circle d-inline-flex p-3 mb-3">
                            <i class="bi bi-shield-lock text-orange fs-1"></i>
                        </div>
                        <h2 class="fw-bold">Forgot Password?</h2>
                        <p class="text-muted">No worries! Enter your email and we'll send you a link to reset your password.</p>
                    </div>

                    <form asp-action="ForgotPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                        
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                            <input asp-for="Email" class="form-control form-control-lg rounded-3 border-light bg-light" placeholder="name@example.com" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-orange btn-lg w-100 rounded-pill shadow-sm mb-3">
                            Send Reset Link
                        </button>

                        <div class="text-center">
                            <a asp-action="Login" class="text-decoration-none text-muted small">
                                <i class="bi bi-arrow-left me-1"></i>Back to Login
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-orange { color: #fd7e14; }
    .bg-orange-subtle { background-color: rgba(253, 126, 20, 0.1); }
    .btn-orange { background-color: #fd7e14; color: white; border: none; }
    .btn-orange:hover { background-color: #e8590c; color: white; }
    .form-control:focus { border-color: #fd7e14; box-shadow: 0 0 0 0.25rem rgba(253, 126, 20, 0.25); }
</style>
