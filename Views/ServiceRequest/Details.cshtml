@model FixItNepal.Models.ServiceRequest
@{
    ViewData["Title"] = "Request Details";
    bool isCustomer = ViewBag.IsCustomer ?? false;
    bool isProvider = ViewBag.IsProvider ?? false;
    bool hasAlreadyBid = ViewBag.HasAlreadyBid ?? false;
}

<div class="container mt-5 mb-5">
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Left Column: Request Details -->
        <div class="col-lg-7 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-light text-primary border border-primary-subtle mb-2">@Model.ServiceCategory.Name</span>
                        <h3 class="fw-bold mb-0">@Model.Title</h3>
                    </div>
                    @switch(Model.Status)
                    {
                        case FixItNepal.Models.ServiceRequestStatus.Open:
                            <span class="badge bg-success fs-6 px-3 py-2 rounded-pill">Open</span>
                            break;
                        case FixItNepal.Models.ServiceRequestStatus.Bidding:
                            <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill">Bidding Active</span>
                            break;
                        case FixItNepal.Models.ServiceRequestStatus.Accepted:
                            <span class="badge bg-info fs-6 px-3 py-2 rounded-pill">Accepted</span>
                            break;
                        default:
                            <span class="badge bg-secondary fs-6 px-3 py-2 rounded-pill">@Model.Status</span>
                            break;
                    }
                </div>
                
                @if (isCustomer && Model.Status == FixItNepal.Models.ServiceRequestStatus.Open && !Model.Bids.Any())
                {
                    <div class="px-4 pt-3 text-end">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm rounded-pill"><i class="bi bi-pencil me-1"></i>Edit Request</a>
                    </div>
                }

                <div class="card-body p-4">
                    <div class="d-flex align-items-center text-muted small mb-4">
                        <i class="bi bi-clock me-2"></i> Posted @Model.CreatedAt.ToString("f")
                        <span class="mx-3 text-light">|</span>
                        <i class="bi bi-person me-2"></i> @Model.Customer.User.FullName
                    </div>

                    <h6 class="fw-bold text-secondary mb-3">Problem Description</h6>
                    <div class="p-3 bg-light rounded text-dark mb-4" style="white-space: pre-wrap;">@Model.Description</div>

                    <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-geo-alt text-primary me-2"></i>Service Location</h6>
                    <p class="text-muted mb-2">@(string.IsNullOrEmpty(Model.Address) ? "Location provided via map coordinates" : Model.Address)</p>
                    
                    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                    {
                        <div id="requestMap" class="rounded border" style="height: 250px;"></div>
                        <input type="hidden" id="reqLat" value="@Model.Latitude.Value" />
                        <input type="hidden" id="reqLng" value="@Model.Longitude.Value" />
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Bidding Section -->
        <div class="col-lg-5">
            
            @if (isProvider)
            {
                <div class="card shadow-sm border-0 mb-4 border-top border-primary border-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3"><i class="bi bi-tag me-2 text-primary"></i>Submit Your Bid</h5>
                        
                        @if (Model.Status != FixItNepal.Models.ServiceRequestStatus.Open && Model.Status != FixItNepal.Models.ServiceRequestStatus.Bidding)
                        {
                            <div class="alert alert-secondary">This request is no longer accepting new bids.</div>
                        }
                        else if (hasAlreadyBid)
                        {
                            var myBid = Model.Bids.FirstOrDefault(b => b.ServiceProvider.UserId == User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value);
                            <div class="alert alert-success mb-3">
                                <strong><i class="bi bi-check-circle me-2"></i>Bid Submitted</strong><br/>
                                You proposed <strong>Rs. @myBid?.ProposedPrice</strong>.<br/>
                                <div class="text-muted small mt-1 fst-italic">"@myBid?.Notes"</div>
                            </div>

                            if (myBid?.CustomerCounterPrice != null)
                            {
                                <div class="alert alert-warning border-warning">
                                    <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle me-2"></i>Customer Counter-Offer!</h6>
                                    <p class="mb-1">The customer proposed: <strong>Rs. @myBid.CustomerCounterPrice</strong></p>
                                    @if (!string.IsNullOrEmpty(myBid.CustomerCounterMessage))
                                    {
                                        <p class="mb-2 small">"@myBid.CustomerCounterMessage"</p>
                                    }
                                    <p class="mb-0 small">Update your bid below if you agree, or adjust your price.</p>
                                </div>
                            }

                            // Update Bid Form
                            <div class="mt-4 border-top pt-3">
                                <h6>Update Your Bid</h6>
                                <form asp-action="UpdateBid" method="post">
                                    <input type="hidden" name="bidId" value="@myBid?.Id" />
                                    
                                    <div class="mb-2">
                                        <label class="form-label fw-bold small text-secondary">New Price (NPR)</label>
                                        <input type="number" name="ProposedPrice" class="form-control form-control-sm" required min="1" step="0.01" value="@myBid?.ProposedPrice" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label fw-bold small text-secondary">Estimated Time</label>
                                        <input type="text" name="EstimatedTime" class="form-control form-control-sm" required value="@myBid?.EstimatedTime" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold small text-secondary">Updated Message</label>
                                        <textarea name="Notes" class="form-control form-control-sm" rows="2" required>@myBid?.Notes</textarea>
                                    </div>
                                    <button type="submit" class="btn btn-outline-primary btn-sm w-100 fw-bold">Update Offer</button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <form asp-action="SubmitBid" method="post">
                                <input type="hidden" name="ServiceRequestId" value="@Model.Id" />
                                
                                <div class="mb-3">
                                    <label class="form-label fw-bold small text-secondary">Proposed Price (NPR)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">Rs.</span>
                                        <input type="number" name="ProposedPrice" class="form-control" required min="1" step="0.01" placeholder="e.g., 1500" />
                                    </div>
                                    <div class="form-text small">This is the total amount you are asking for the job.</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small text-secondary">Estimated Time</label>
                                    <input type="text" name="EstimatedTime" class="form-control" required placeholder="e.g., 2 hours, Tomorrow morning" />
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold small text-secondary">Message to Customer</label>
                                    <textarea name="Notes" class="form-control" rows="3" required placeholder="Explain your pricing, what's included, why they should choose you..."></textarea>
                                </div>

                                <button type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow-sm">Submit Bid</button>
                            </form>
                        }
                    </div>
                </div>
            }

            @if (isCustomer)
            {
                <h5 class="fw-bold mb-3 text-secondary border-bottom pb-2">
                    <i class="bi bi-people me-2"></i>Provider Bids (@Model.Bids.Count)
                </h5>

                @if (!Model.Bids.Any())
                {
                    <div class="text-center p-4 bg-white rounded-3 shadow-sm border border-secondary-subtle">
                        <i class="bi bi-hourglass-split fs-2 text-muted mb-2 d-block"></i>
                        <p class="text-secondary mb-0">Waiting for providers to bid on your request...</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var bid in Model.Bids.OrderBy(b => b.ProposedPrice))
                        {
                            <div class="card shadow-sm border-0 @(bid.Status == FixItNepal.Models.BidStatus.Accepted ? "border-success border-2" : "")">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(bid.ServiceProvider.User.ProfilePicture))
                                            {
                                                <img src="~/uploads/profiles/@bid.ServiceProvider.User.ProfilePicture" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center me-2 fw-bold" style="width: 40px; height: 40px;">
                                                    @bid.ServiceProvider.User.FullName.Substring(0, 1)
                                                </div>
                                            }
                                            <div>
                                                <h6 class="mb-0 fw-bold">@bid.ServiceProvider.User.FullName</h6>
                                                <div class="small text-warning">
                                                    <i class="bi bi-star-fill"></i> @bid.ServiceProvider.AverageRating.ToString("0.0")
                                                </div>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <h5 class="fw-bold text-success mb-0">Rs. @bid.ProposedPrice</h5>
                                            <span class="badge bg-light text-dark border"><i class="bi bi-clock me-1"></i>@bid.EstimatedTime</span>
                                        </div>
                                    </div>
                                    
                                    <div class="bg-light p-2 rounded small text-secondary mb-3 fst-italic">
                                        "@bid.Notes"
                                    </div>

                                    @if (Model.Status == FixItNepal.Models.ServiceRequestStatus.Open || Model.Status == FixItNepal.Models.ServiceRequestStatus.Bidding)
                                    {
                                        if (bid.CustomerCounterPrice != null && bid.Status == FixItNepal.Models.BidStatus.Pending)
                                        {
                                            <div class="alert alert-warning mb-3 py-2 small">
                                                <strong>Counter-Offer Sent: Rs. @bid.CustomerCounterPrice</strong><br/>
                                                Waiting for provider's updated bid...
                                            </div>
                                        }

                                        <div class="d-flex gap-2 mb-2">
                                            <form asp-action="AcceptBid" method="post" class="flex-grow-1">
                                                <input type="hidden" name="bidId" value="@bid.Id" />
                                                <button type="submit" class="btn btn-sm btn-success w-100 fw-bold" onclick="return confirm('Are you sure you want to accept this bid? You will be redirected to pay a token amount to confirm the booking.');">
                                                    Accept 
                                                </button>
                                            </form>
                                            
                                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#counterForm-@bid.Id">
                                                Counter
                                            </button>
                                            
                                            <a href="/Chat/Index?userId=@bid.ServiceProvider.UserId" class="btn btn-sm btn-outline-secondary" title="Chat">
                                                <i class="bi bi-chat-dots"></i>
                                            </a>
                                        </div>

                                        <!-- Counter Offer Form (Collapse) -->
                                        <div class="collapse mt-3" id="counterForm-@bid.Id">
                                            <div class="card card-body bg-light border-0 p-3 shadow-sm rounded">
                                                <h6 class="fw-bold fs-6 mb-2">Send Counter-Offer</h6>
                                                <form asp-action="CounterBid" method="post">
                                                    <input type="hidden" name="bidId" value="@bid.Id" />
                                                    <div class="mb-2">
                                                        <input type="number" name="CounterPrice" class="form-control form-control-sm" required min="1" step="0.01" placeholder="Your price (NPR)" />
                                                    </div>
                                                    <div class="mb-2">
                                                        <input type="text" name="CounterMessage" class="form-control form-control-sm" placeholder="Optional message..." />
                                                    </div>
                                                    <button type="submit" class="btn btn-primary btn-sm w-100">Send Offer</button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                    else if (bid.Status == FixItNepal.Models.BidStatus.Accepted)
                                    {
                                        <div class="text-center mt-2">
                                            <span class="badge bg-success w-100 py-2"><i class="bi bi-check-circle me-2"></i>Bid Accepted</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            
            @if (!isCustomer && !isProvider)
            {
                <div class="alert alert-info">Please login to interact with this request.</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/maps.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const latInput = document.getElementById("reqLat");
            const lngInput = document.getElementById("reqLng");
            
            if (latInput && lngInput) {
                const lat = parseFloat(latInput.value);
                const lng = parseFloat(lngInput.value);
                
                const mapService = new LeafletMapService("requestMap", { 
                    center: [lat, lng], 
                    zoom: 15,
                    readOnly: true
                });
                
                setTimeout(() => {
                    mapService.init();
                    if (mapService.map) {
                        mapService.map.invalidateSize();
                        mapService.addMarker(lat, lng, "Customer Location");
                    }
                }, 500);
            }
        });
    </script>
}
