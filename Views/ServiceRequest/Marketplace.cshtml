@model IEnumerable<FixItNepal.Models.ServiceRequest>
@{
    ViewData["Title"] = "Job Marketplace";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0 text-primary-custom"><i class="bi bi-shop me-2"></i>Job Marketplace</h3>
        <span class="text-muted">Available jobs in your category</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center p-5 bg-white rounded-3 shadow-sm border mt-4">
            <i class="bi bi-search fs-1 text-muted mb-3 d-block"></i>
            <h5>No matching jobs right now</h5>
            <p class="text-secondary">Check back later for new customer requests in your service category.</p>
        </div>
    }
    else
    {
        <div class="row g-4 mt-2">
            @foreach (var request in Model)
            {
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm border-0 h-100 job-card">
                        <div class="card-body p-4 position-relative">
                            
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title fw-bold mb-1">@request.Title</h5>
                                    <div class="text-muted small">
                                        <i class="bi bi-person-circle me-1"></i> @request.Customer?.User?.FullName
                                    </div>
                                </div>
                                @{
                                    var myBid = request.Bids?.FirstOrDefault(b => b.ServiceProvider?.UserId == ViewBag.ProviderUserId);
                                    if (myBid != null)
                                    {
                                        if (myBid.CustomerCounterPrice != null)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i>Counter Offer</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary"><i class="bi bi-check-circle me-1"></i>Bid Submitted</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Accepting Bids</span>
                                    }
                                }
                            </div>
                            
                            <p class="text-secondary small mt-3 text-truncate-3">@request.Description</p>
                            
                            <div class="row mt-4 mb-3 g-2">
                                <div class="col-12">
                                    <div class="d-flex align-items-center text-muted small bg-light p-2 rounded">
                                        <i class="bi bi-geo-alt text-primary me-2"></i> @(string.IsNullOrEmpty(request.Address) ? "Location provided via map" : request.Address)
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="d-flex align-items-center text-muted small bg-light p-2 rounded">
                                        <i class="bi bi-clock text-primary me-2"></i> Posted @request.CreatedAt.ToString("g")
                                    </div>
                                </div>
                            </div>
                            
                            <hr class="my-3 text-muted">
                            
                            <div class="text-end">
                                <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-primary rounded-pill px-4">View & Bid</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
.job-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.job-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    border-left: 4px solid #0d6efd !important;
}
.text-truncate-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
</style>
