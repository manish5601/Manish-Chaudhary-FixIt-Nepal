@model IEnumerable<FixItNepal.Models.Dispute>
@{
    ViewData["Title"] = "Dispute Management";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">Dispute Management</h1>
        <div class="d-flex gap-2">
            <span class="badge bg-danger">@Model.Count(d => d.Status == FixItNepal.Models.DisputeStatus.Open) Open</span>
            <span class="badge bg-success">@Model.Count(d => d.Status == FixItNepal.Models.DisputeStatus.Resolved) Resolved</span>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>ID</th>
                        <th>Created</th>
                        <th>Raised By</th>
                        <th>Service / Provider</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">No disputes found.</td>
                        </tr>
                    }
                    @foreach (var dispute in Model)
                    {
                        <tr>
                            <td>#@dispute.Id</td>
                            <td>@dispute.CreatedAt.ToShortDateString()</td>
                            <td>
                                <div>@dispute.RaisedBy.FullName</div>
                                <small class="text-muted">@(dispute.RaisedById == dispute.Booking.Customer.UserId ? "Customer" : "Provider")</small>
                            </td>
                            <td>
                                <div>@dispute.Booking.ServiceItem.Name</div>
                                <small class="text-muted">By: @dispute.Booking.ServiceProvider.User.FullName</small>
                            </td>
                            <td>
                                <strong>@dispute.Reason</strong>
                                <div class="small text-muted text-truncate" style="max-width: 200px;">@dispute.Description</div>
                            </td>
                            <td>
                                <span class="badge @(dispute.Status == FixItNepal.Models.DisputeStatus.Open ? "bg-danger" : 
                                                   dispute.Status == FixItNepal.Models.DisputeStatus.UnderReview ? "bg-warning text-dark" : 
                                                   dispute.Status == FixItNepal.Models.DisputeStatus.Resolved ? "bg-success" : "bg-secondary")">
                                    @dispute.Status
                                </span>
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#resolveModal-@dispute.Id">
                                    Manage
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @foreach (var dispute in Model)
    {
        <!-- Modal -->
        <div class="modal fade" id="resolveModal-@dispute.Id" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content border-0">
                    <div class="modal-header border-0 shadow-sm bg-primary text-white">
                        <h5 class="modal-title fw-bold">Manage Dispute #@dispute.Id</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <form asp-action="ResolveDispute" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@dispute.Id" />
                        <div class="modal-body p-4">
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <h6 class="text-muted small fw-bold text-uppercase mb-3">Raised By</h6>
                                    <div class="d-flex align-items-center mb-2">
                                        <div class="bg-light rounded-circle p-2 me-3">
                                            <i class="bi bi-person text-primary"></i>
                                        </div>
                                        <div>
                                            <p class="mb-0 fw-bold">@dispute.RaisedBy.FullName</p>
                                            <p class="small text-muted mb-0">@dispute.RaisedBy.Email</p>
                                            <p class="small text-muted mb-0">@dispute.RaisedBy.PhoneNumber</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    @{
                                        var raisedAgainst = dispute.RaisedById == dispute.Booking.Customer.UserId 
                                            ? dispute.Booking.ServiceProvider.User 
                                            : dispute.Booking.Customer.User;
                                        var againstRole = dispute.RaisedById == dispute.Booking.Customer.UserId ? "Provider" : "Customer";
                                    }
                                    <h6 class="text-muted small fw-bold text-uppercase mb-3">Raised Against (@againstRole)</h6>
                                    <div class="d-flex align-items-center mb-2">
                                        <div class="bg-light rounded-circle p-2 me-3">
                                            <i class="bi bi-person-badge text-danger"></i>
                                        </div>
                                        <div>
                                            <p class="mb-0 fw-bold">@raisedAgainst.FullName</p>
                                            <p class="small text-muted mb-0">@raisedAgainst.Email</p>
                                            <p class="small text-muted mb-0">@raisedAgainst.PhoneNumber</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-4">
                                <div class="col-md-12">
                                    <div class="card bg-light border-0">
                                        <div class="card-body">
                                            <h6 class="small fw-bold text-uppercase mb-3">Service Details</h6>
                                            <div class="row">
                                                <div class="col-sm-4">
                                                    <p class="small mb-1 text-muted">Service</p>
                                                    <p class="fw-bold">@dispute.Booking.ServiceItem.Name</p>
                                                </div>
                                                <div class="col-sm-4">
                                                    <p class="small mb-1 text-muted">Booking Date</p>
                                                    <p class="fw-bold">@dispute.Booking.BookingDate.ToShortDateString()</p>
                                                </div>
                                                <div class="col-sm-4">
                                                    <p class="small mb-1 text-muted">Total Cost</p>
                                                    <p class="fw-bold text-success">Rs. @dispute.Booking.TotalPrice</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h6 class="text-muted small fw-bold text-uppercase mb-2">Dispute Reason</h6>
                                <p class="fw-bold mb-1">@dispute.Reason</p>
                                <div class="p-3 bg-white border rounded small text-secondary">
                                    @dispute.Description
                                </div>
                            </div>

                            <hr />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Action / Status</label>
                                    <select name="status" class="form-select border-primary-subtle">
                                        <option value="Open" selected="@(dispute.Status == FixItNepal.Models.DisputeStatus.Open)">Open</option>
                                        <option value="UnderReview" selected="@(dispute.Status == FixItNepal.Models.DisputeStatus.UnderReview)">Under Review</option>
                                        <option value="Resolved" selected="@(dispute.Status == FixItNepal.Models.DisputeStatus.Resolved)">Resolved</option>
                                        <option value="Rejected" selected="@(dispute.Status == FixItNepal.Models.DisputeStatus.Rejected)">Rejected</option>
                                    </select>
                                </div>
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-bold">Resolution Note</label>
                                    <textarea name="resolution" class="form-control border-primary-subtle" rows="4" placeholder="Describe the resolution or internal notes..." required>@dispute.Resolution</textarea>
                                    <div class="form-text small">This note will be visible to the user who raised the dispute.</div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-0 bg-light">
                            <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4">Save Resolution</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
