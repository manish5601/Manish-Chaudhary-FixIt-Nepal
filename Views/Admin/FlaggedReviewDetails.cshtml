@model FixItNepal.Models.Review
@{
    ViewData["Title"] = "Flagged Review Details";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">Flagged Review Details</h1>
        <a asp-action="Moderation" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Moderation</a>
    </div>

    <div class="row">
        <!-- Review Context -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Flagged Content</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="fw-bold text-muted d-block small text-uppercase">Rating</label>
                        <div>
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi bi-star-fill @(i <= Model.Rating ? "text-warning" : "text-muted")"></i>
                            }
                        </div>
                    </div>
                    <div class="mb-3 border rounded p-3 bg-light">
                        <label class="fw-bold text-muted d-block small text-uppercase mb-2">Comment</label>
                        <p class="mb-0" style="white-space: pre-wrap;">@(string.IsNullOrEmpty(Model.Comment) ? "(No comment provided)" : Model.Comment)</p>
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold text-muted d-block small text-uppercase">Flag Reason / Admin Note</label>
                        <div class="text-danger fw-bold">@Model.AdminNote</div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <form asp-action="DismissFlag" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Keep (Dismiss Flag)</button>
                        </form>
                        <form asp-action="DeleteReview" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this review?')"><i class="bi bi-trash"></i> Delete Review</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Booking Context -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Booking Context (ID: #@Model.BookingId)</h5>
                </div>
                <div class="card-body">
                    <p><strong>Service:</strong> @Model.Booking?.ServiceItem?.Name</p>
                    <p><strong>Status:</strong> @Model.Booking?.Status.ToString()</p>
                    <p><strong>Date:</strong> @Model.Booking?.BookingDate.ToShortDateString()</p>
                    <a asp-action="Bookings" asp-route-search="@Model.BookingId" class="btn btn-sm btn-outline-primary mt-2">View Booking in List</a>
                </div>
            </div>
        </div>

        <!-- Contact Cards -->
        <div class="col-md-4">
            <!-- Customer Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Customer (Reviewer)</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        @if (!string.IsNullOrEmpty(Model.Customer?.User?.ProfilePicture))
                        {
                            <img src="~/uploads/profiles/@Model.Customer.User.ProfilePicture" class="rounded-circle me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                <span class="fw-bold fs-4">@Model.Customer?.User?.FullName?.Substring(0, 1).ToUpper()</span>
                            </div>
                        }
                        <div>
                            <h6 class="mb-0">@Model.Customer?.User?.FullName</h6>
                        </div>
                    </div>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><i class="bi bi-envelope text-muted me-2"></i> <a href="mailto:@Model.Customer?.User?.Email">@Model.Customer?.User?.Email</a></li>
                        <li><i class="bi bi-telephone text-muted me-2"></i> <a href="tel:@Model.Customer?.User?.PhoneNumber">@Model.Customer?.User?.PhoneNumber</a></li>
                    </ul>
                </div>
            </div>

            <!-- Provider Card -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Service Provider (Reviewed)</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        @if (!string.IsNullOrEmpty(Model.ServiceProvider?.User?.ProfilePicture))
                        {
                            <img src="~/uploads/profiles/@Model.ServiceProvider.User.ProfilePicture" class="rounded-circle me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-info text-white d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                <span class="fw-bold fs-4">@Model.ServiceProvider?.User?.FullName?.Substring(0, 1).ToUpper()</span>
                            </div>
                        }
                        <div>
                            <h6 class="mb-0">@Model.ServiceProvider?.User?.FullName</h6>
                        </div>
                    </div>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><i class="bi bi-envelope text-muted me-2"></i> <a href="mailto:@Model.ServiceProvider?.User?.Email">@Model.ServiceProvider?.User?.Email</a></li>
                        <li><i class="bi bi-telephone text-muted me-2"></i> <a href="tel:@Model.ServiceProvider?.User?.PhoneNumber">@Model.ServiceProvider?.User?.PhoneNumber</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
