@{
    ViewData["Title"] = "Customer Dashboard";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2 class="fw-bold text-primary-custom">Welcome Back!</h2>
            <p class="text-muted">Manage your home service requests and track your activities.</p>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <!-- Browse Services -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 bg-primary text-white hover-card transition-all">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <i class="bi bi-search fs-1 opacity-50"></i>
                    </div>
                    <div>
                        <h6 class="text-white-50 small text-uppercase fw-bold">Book Services</h6>
                        <h4 class="fw-bold mb-3">Find Help</h4>
                    </div>
                    <a asp-controller="Home" asp-action="Services" class="btn btn-light text-primary w-100 mt-2 rounded-pill fw-bold">Browse Services</a>
                </div>
            </div>
        </div>

        <!-- My Bookings -->
        <div class="col-md-3">
             <div class="card shadow-sm border-0 h-100 hover-card transition-all">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <i class="bi bi-calendar-check fs-1 text-primary opacity-50"></i>
                    </div>
                    <div>
                        <h6 class="text-muted small text-uppercase fw-bold">My Bookings</h6>
                        <h4 class="fw-bold mb-3">Manage</h4>
                    </div>
                    <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-outline-primary w-100 mt-2 rounded-pill fw-bold">View History</a>
                </div>
            </div>
        </div>

        <!-- My Requests (Marketplace) -->
        <div class="col-md-3">
             <div class="card shadow-sm border-0 h-100 hover-card transition-all">
                <div class="card-body p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-list-task fs-1 text-primary opacity-50"></i>
                    </div>
                    <h6 class="text-muted small text-uppercase fw-bold mb-1">Custom Jobs</h6>
                    <h4 class="fw-bold mb-3">My Requests</h4>
                    <a asp-controller="ServiceRequest" asp-action="MyRequests" class="btn btn-outline-primary w-100 mt-2 rounded-pill fw-bold">View & Post</a>
                </div>
            </div>
        </div>

        <!-- Profile Settings -->
        <div class="col-md-3">
             <div class="card shadow-sm border-0 h-100 hover-card transition-all">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <i class="bi bi-person-gear fs-1 text-primary opacity-50"></i>
                    </div>
                    <div>
                        <h6 class="text-muted small text-uppercase fw-bold">Profile</h6>
                        <h4 class="fw-bold mb-3">Settings</h4>
                    </div>
                    <a asp-controller="Customer" asp-action="Profile" class="btn btn-outline-primary w-100 mt-2 rounded-pill fw-bold">Edit Profile</a>
                </div>
            </div>
        </div>

        <!-- My Disputes -->
        <div class="col-md-3">
             <div class="card shadow-sm border-0 h-100 border-start border-4 border-danger hover-card transition-all">
                <div class="card-body p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-exclamation-triangle-fill fs-1 text-danger opacity-50"></i>
                    </div>
                    <h6 class="text-muted small text-uppercase fw-bold mb-1">Issue Tracking</h6>
                    <h4 class="fw-bold mb-3">My Disputes</h4>
                    <a asp-controller="Dispute" asp-action="MyDisputes" class="btn btn-outline-danger w-100 mt-2 rounded-pill btn-sm fw-bold">Track Progress</a>
                </div>
            </div>
        </div>
    </div>
</div>
